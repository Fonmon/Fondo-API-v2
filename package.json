{
  "name": "fondo-api-v2",
  "version": "0.0.1",
  "description": "Fondo Montañez API - NestJS migration",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:scheduler": "ts-node -r tsconfig-paths/register src/scheduler/scheduler-main.ts",
    "start:scheduler:prod": "node dist/scheduler/scheduler-main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --config jest-unit.json --coverage && jest --config jest-e2e.json --runInBand",
    "test:unit": "jest --config jest-unit.json --coverage",
    "test:unit:watch": "jest --watch --config jest-unit.json --coverage",
    "test:e2e": "jest --config jest-e2e.json --runInBand",
    "test:e2e:watch": "jest --watch --config jest-e2e.json --runInBand"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1012.0",
    "@aws-sdk/client-sqs": "^3.1012.0",
    "@google-cloud/storage": "^7.19.0",
    "@nestjs/common": "^11.1.17",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.17",
    "@nestjs/platform-express": "^11.1.17",
    "@nestjs/schedule": "^6.1.1",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@types/pg": "^8.18.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "handlebars": "^4.7.8",
    "multer": "^2.1.1",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.16",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.17",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.0",
    "jest": "^30.3.0",
    "prettier": "^3.5.3",
    "prisma": "^7.5.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
