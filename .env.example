# Copy to `.env` and adjust. Never commit a filled-in copy.
# Every variable is validated at boot by src/config/env.schema.ts; a missing required one
# aborts startup with a message naming it.

# --- required -----------------------------------------------------------------
# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://fondouser:fondo@localhost:5432/fondodev?schema=public"
# v1: os.environ['AWS_REGION'] - SES and SQS clients.
AWS_REGION="us-east-2"
# v1: os.environ['DEFAULT_FROM_EMAIL'] - the SES `Source` address.
DEFAULT_FROM_EMAIL="Fondo Montanez <no-reply@fonmon.minagle.com>"
# v1: api/settings/production.py:11 reads this exact variable for `settings.SECRET_KEY`;
# development.py and test.py hardcode a literal instead.
# v2 signs its **own** password-reset tokens with it (P3-D4) — it does not share Django's
# token format, so nothing has to match across the cutover.
# ⚠️ REQUIRED in production: the environment schema refuses to boot without it. Outside
# production it falls back to a documented development literal, mirroring v1.
DJANGO_SECRET_KEY=""

# v1: os.environ.get('HOST_URL_APP') - the `{% host %}` tag in every Spanish email.
# Required in v2 (deviation P0-D1): v1 silently renders "None" when it is unset.
HOST_URL_APP="http://localhost:3000"

# --- optional -----------------------------------------------------------------
# development | test | production. Defaults to NODE_ENV.
NODE_ENV="development"
ENVIRONMENT="development"
# v1: gunicorn --bind 0.0.0.0:8443
PORT="8443"
# v1: os.environ.get('NOTIFICATIONS_QUEUE_URL', None) - optional, publish failures are
# swallowed exactly as in v1.
# NOTIFICATIONS_QUEUE_URL=""
# v1 hardcodes "fonmon" in services/file.py.
GCS_BUCKET="fonmon"
# v1: settings.LANGUAGE_LOCALE / settings.TIME_ZONE
LANGUAGE_LOCALE="es"
TIME_ZONE="America/Bogota"

# --- scheduler (Phase 7b) -----------------------------------------------------
# Whether THIS process runs the 10:00/14:00 America/Bogota scheduler cron - the v2
# replacement for v1's separate `celery -A api beat` container.
#
# ⚠️ Leave it unset on every API replica and set it to "true" on EXACTLY ONE process.
# v1's web image never ran beat at any replica count; this flag is how v2 keeps that
# property. Two processes with it set will not double-send (the runner claims each row
# with an atomic `UPDATE ... WHERE processed = false`) but they will log a warning, and
# the flag is the primary control, not the claim.
#
# Unset/empty = disabled. Accepted true values: true, 1, yes, on.
# SCHEDULER_ENABLED="false"

# --- e2e tests ----------------------------------------------------------------
# The e2e suite provisions and uses its own database; it never touches the dev one.
TEST_DATABASE_URL="postgresql://fondouser:fondo@localhost:5432/fondo_api_test?schema=public"
