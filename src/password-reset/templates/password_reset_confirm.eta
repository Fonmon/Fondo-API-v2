<!DOCTYPE html>
<html>

<head>
    <title>Fondo Montañez</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
	
	<link rel="stylesheet" type="text/css" href="/static/style.css">
	<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.2.1/css/bootstrap.min.css" integrity="sha384-GJzZqFGwb1QTTN6wy59ffF1BuGJpLSa9DkKMp0DgiMDm4iYMj70gZWKYbI706tWS" crossorigin="anonymous">
</head>

<body>
    
    <div class="container">
        <center><img class="card-img-top banner" src="/static/banner.png"></center>
        <% if (it.validlink) { %>
            <form method="post" class="form">
                <center><h2>Cambio de contraseña</h2></center>
<%~ it.field_errors %>
                <input type="hidden" name="csrfmiddlewaretoken" value="<%= it.csrf_token %>">
                <div class="form-group">
                    <input type="password" class="form-control" id="id_new_password1" name="new_password1" required placeholder="Nueva contraseña">
                </div>
                <div class="form-group">
                    <input type="password" class="form-control" id="id_new_password2" name="new_password2" required placeholder="Confirmación de nueva contraseña">
                </div>
                <button class="btn btn-danger btn-lg btn-block" type="submit">Cambiar contraseña</button>
            </form>
        <% } else { %>
            <div class="form">
                <div class="alert alert-danger">
                    <p>
                        El enlace de restauración de contraseña es inválido, posiblemente porque ya ha sido usado.
                        Favor enviar una nueva solicitud de restauración de contraseña.
                    </p>
                </div>
            </div>
        <% } %>
    </div>
    
</body>

</html>
